[node name="IceShard" type="Button" parent="MarginContainer/TextureRect/MarginContainer/VSplitContainer/HBoxContainer/VBoxContainer4"]
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 4
text = "Ice Shard"
icon = ExtResource("4_4jqt7")
icon_alignment = 1
vertical_icon_alignment = 0
script = ExtResource("7_xo81t")
cost_in_peaks = Array[int]([50, 500, 5000, 50000, 500000])
short_description = "Shoot 1 ice shard per level. Damage increases every level."
long_description = "You shoot freezing shards of ice so you don't have to feel your pain.

Denial is nature’s way of letting in only as much as we can handle. As you accept the reality of the loss and start to ask yourself questions, you are unknowingly beginning the healing process. You are becoming stronger, and the denial is beginning to fade. But as you proceed, all the feelings you were denying begin to surface."

