[node name="Destruction" type="Button" parent="MarginContainer/TextureRect/MarginContainer/VSplitContainer/HBoxContainer/VBoxContainer5"]
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 4
text = "Destruction"
icon = ExtResource("6_r3fwn")
icon_alignment = 1
vertical_icon_alignment = 0
script = ExtResource("7_xo81t")
cost_in_peaks = Array[int]([20, 200, 20000, 200000, 20000000])
short_description = "Your melee damage doubles every level."
long_description = "As you release your anger, you become more skilled at channeling it.

Underneath anger is pain - your pain. It is natural to feel deserted and abandoned. Anger is strength and it can be an anchor, giving temporary structure to the nothingness of loss. A connection made from the strength of anger feels better than nothing. The anger is just another indication of the intensity of your love."

