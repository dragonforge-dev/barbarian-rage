text = "Ice Sword"
icon = ExtResource("11_6gd42")
icon_alignment = 1
vertical_icon_alignment = 0
script = ExtResource("7_xo81t")
cost_in_peaks = Array[int]([1000000000000])
short_description = "You can create a two-handed blade made of ice harder than steel."
long_description = "You gain the sword of icy resolve as you learn to accept death and move forwards.

Acceptance is often confused with the notion of being “OK” with what has happened. This is not the case. Most people don’t ever feel OK about the loss of a loved one. This stage is about accepting the reality that our loved ones are physically gone and this new reality is the permanent reality. We learn to live with it."

