[node name="RemorhazSpeed" type="Button" parent="MarginContainer/TextureRect/MarginContainer/VSplitContainer/HBoxContainer/VBoxContainer5"]
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 4
text = "Remorhaz Speed"
icon = ExtResource("5_2wmw5")
icon_alignment = 1
vertical_icon_alignment = 0
script = ExtResource("7_xo81t")
cost_in_peaks = Array[int]([2, 20, 200, 2000, 20000, 200000, 2000000, 20000000, 200000000, 2000000000])
short_description = "Increase speed 10% per level."
long_description = "The Remorhaz is an ice worm famed for its lightning speed when angered.

Anger is a necessary stage of the healing process. Be willing to feel your anger, even though it may seem endless. The more you truly feel it, the more it will begin to dissipate and the more you will heal. There are many other emotions under the anger, but anger is the emotion we feel most powerfully. The truth is that anger has no limits."

