[node name="IceWave" type="Button" parent="MarginContainer/TextureRect/MarginContainer/VSplitContainer/HBoxContainer/VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 4
text = "Ice Flower
"
icon = ExtResource("8_vge1c")
icon_alignment = 1
vertical_icon_alignment = 0
script = ExtResource("7_xo81t")
cost_in_peaks = Array[int]([100, 2000, 40000, 800000, 16000000])
short_description = "Damage increases 1.5x per level.
Range increases 0.5 meters per level."
long_description = "You have bargained with your pain to unleash it in waves to damage what's around you.

We may even bargain with the pain. We will do anything not to feel the pain of this loss. We remain in the past, trying to negotiate our way out of the hurt. People forget that the stages are responses to feelings as we flip in and out of one and then another. We may feel a feeling in one stage, then another and back again to the first one."

