[node name="TimeDenial" type="Button" parent="MarginContainer/TextureRect/MarginContainer/VSplitContainer/HBoxContainer/VBoxContainer4"]
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 4
text = "Time Denial"
icon = ExtResource("3_wmol4")
icon_alignment = 1
vertical_icon_alignment = 0
script = ExtResource("7_xo81t")
cost_in_peaks = Array[int]([5, 50, 500, 5000, 50000, 500000, 5000000, 50000000, 500000000, 5000000000])
short_description = "12.5% increase to depression timer length per level."
long_description = "This ability pushes off depression a little longer, resulting in an increase in the amount of time you can spend in a room.

Denial helps us to survive loss. In this stage, the world becomes meaningless and overwhelming. Life makes no sense. We are in a state of shock and denial. We go numb. We wonder how we can go on, if we can go on, why we should go on."

