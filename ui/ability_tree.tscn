[node name="QuantCondenser" type="Button" parent="MarginContainer/TextureRect/MarginContainer/VSplitContainer/HBoxContainer/VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 4
text = "Quant Condenser
"
icon = ExtResource("7_f04gl")
icon_alignment = 1
vertical_icon_alignment = 0
script = ExtResource("7_xo81t")
cost_in_peaks = Array[int]([10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000, 10000000000])
short_description = "Peaks you gain are worth 10x as much per level."
long_description = "Your bargaining with death emotionally charges the power of the quant you collect.

We want life returned to what is was; we want our loved ones restored. We want to go back in time: stop their death from happening … if only, if only, if only. Guilt is often bargaining’s companion. The “if onlys” cause us to find fault in ourselves and what we think we could have done differently."

