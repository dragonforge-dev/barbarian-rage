[node name="IceBomb" type="Button" parent="MarginContainer/TextureRect/MarginContainer/VSplitContainer/HBoxContainer/VBoxContainer2"]
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 4
text = "Ice Bomb"
icon = ExtResource("10_p2nyd")
icon_alignment = 1
vertical_icon_alignment = 0
script = ExtResource("7_xo81t")
cost_in_peaks = Array[int]([1, 100, 10000, 1000000, 100000000])
short_description = "Damage increases 20% per level.
Delay is reduced by 25% per level."
long_description = "You coalesce your depression and explode it as an icy bomb of despair

We withdraw from life, left in a fog of intense sadness, wondering, perhaps, if there is any point in going on alone? The loss of a loved one is a very depressing situation, and depression is a normal and appropriate response. When a loss fully settles in your soul, it is understandably depressing. Grief is a process of healing. Depression is necessary."

