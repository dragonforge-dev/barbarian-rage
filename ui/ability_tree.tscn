script = ExtResource("7_xo81t")
cost_in_peaks = Array[int]([2000000000000])
short_description = "You can turn your icy calm into literal armor made of ice."
long_description = "You enter a chill, meditative state of emotionlessness in combat that manifests as armor.

The past has been forever changed and we must readjust. Finding acceptance may be just having more good days than bad. We start to listen to our needs; we change, we grow, we evolve. We invest in our friendships and in our relationship with ourselves. We begin to live again, but we cannot do so until we have given grief its time."

