;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Barbarian Rage An Otworld Game"
config/version="1.0.0.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
boot_splash/image="res://assets/ui/splash_screen/Barbarian Rage.png"
config/icon="res://assets/ui/icons/app_icons/256xT_FortressSide_Hi_Def_Icons_Pack2 (153).png"
config/windows_native_icon="res://assets/ui/icons/app_icons/barbarian_rage.ico"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

