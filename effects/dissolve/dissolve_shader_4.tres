code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D tex_frg_7;
uniform float Oscillation = 2;
uniform vec4 ColorParameter : source_color = vec4(0.901961, 0.509804, 0.007843, 1.000000);



void fragment() {
// Input:2
	vec2 n_out2p0 = UV;


// Texture2D:7
	vec4 n_out7p0 = texture(tex_frg_7, n_out2p0);


// Input:3
	float n_out3p0 = TIME;


// FloatFunc:4
	float n_out4p0 = sin(n_out3p0);


// FloatParameter:15
	float n_out15p0 = Oscillation;


// FloatOp:5
	float n_out5p0 = n_out4p0 / n_out15p0;


// FloatOp:8
	float n_out8p0 = n_out7p0.x - n_out5p0;


// FloatFunc:9
	float n_out9p0 = round(n_out8p0);


// FloatOp:10
	float n_in10p1 = 0.05000;
	float n_out10p0 = n_out8p0 - n_in10p1;


// FloatOp:11
	float n_in11p0 = 1.00000;
	float n_out11p0 = n_in11p0 - n_out10p0;


// FloatFunc:12
	float n_out12p0 = round(n_out11p0);


// ColorParameter:14
	vec4 n_out14p0 = ColorParameter;


// VectorOp:13
	vec3 n_out13p0 = vec3(n_out12p0) + vec3(n_out14p0.xyz);


// Output:0
	ALPHA = n_out9p0;
	EMISSION = n_out13p0;


}
