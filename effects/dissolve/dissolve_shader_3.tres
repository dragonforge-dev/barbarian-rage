[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D OriginalTexture : source_color;
uniform sampler2D NoiseTexture;
uniform vec4 EdgeColor : source_color = vec4(0.130000, 1.000000, 1.000000, 1.000000);
uniform float EdgeThickness = 0.05000000074506;
uniform float Dissolve : hint_range(0, 1) = 0;



void fragment() {
	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(OriginalTexture, UV);


	vec4 n_out7p0;
// Texture2D:7
	n_out7p0 = texture(NoiseTexture, UV);


// ColorParameter:10
	vec4 n_out10p0 = EdgeColor;


// FloatParameter:11
	float n_out11p0 = EdgeThickness;


// FloatParameter:8
	float n_out8p0 = Dissolve;


// FloatOp:15
	float n_out15p0 = n_out11p0 + n_out8p0;


// Mix:16
	vec4 n_in16p0 = vec4(0.00000, 0.00000, 0.00000, 0.00000);
	vec4 n_out16p0 = mix(n_in16p0, n_out10p0, vec4(n_out15p0));


// Step:17
	vec4 n_out17p0 = step(n_out7p0, n_out16p0);


// Output:0
	ALBEDO = vec3(n_out3p0.xyz);
	ALPHA = n_out7p0.x;
	EMISSION = vec3(n_out17p0.xyz);
	ALPHA_SCISSOR_THRESHOLD = n_out8p0;


}
"
