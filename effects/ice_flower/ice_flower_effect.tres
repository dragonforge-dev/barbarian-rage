code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform sampler2D tex_frg_2 : source_color;
uniform sampler2D tex_frg_3 : source_color;
uniform float Opacity : hint_range(0, 1) = 1;



void fragment() {
// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, UV);


// Texture2D:3
	vec4 n_out3p0 = texture(tex_frg_3, UV);


// VectorOp:4
	vec4 n_out4p0 = n_out2p0 * n_out3p0;


// FloatParameter:6
	float n_out6p0 = Opacity;


// Fresnel:5
	float n_in5p3 = 0.70000;
	float n_out5p0 = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), n_in5p3);


// FloatOp:7
	float n_out7p0 = n_out6p0 * n_out5p0;


// Output:0
	ALBEDO = vec3(n_out4p0.xyz);
	ALPHA = n_out7p0;


}
"
