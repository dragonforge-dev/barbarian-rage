code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D tex_frg_7;
uniform sampler2D tex_frg_9;
uniform float Time;



void fragment() {
// Input:4
	float n_out4p0 = TIME;


// FloatOp:8
	float n_in8p0 = -0.05000;
	float n_out8p0 = n_in8p0 + n_out4p0;


// Input:5
	vec2 n_out5p0 = UV;


// VectorOp:6
	vec2 n_out6p0 = vec2(n_out8p0) + n_out5p0;


// Texture2D:7
	vec4 n_out7p0 = texture(tex_frg_7, n_out6p0);


// Texture2D:9
	vec4 n_out9p0 = texture(tex_frg_9, vec2(n_out7p0.xy));


// FloatParameter:10
	float n_out10p0 = Time;


// FloatFunc:11
	float n_out11p0 = tan(n_out10p0);


// FloatOp:12
	float n_in12p1 = 3.00000;
	float n_out12p0 = n_out11p0 / n_in12p1;


// VectorOp:13
	vec2 n_out13p0 = pow(vec2(n_out7p0.xy), vec2(n_out12p0));


// VectorOp:14
	vec2 n_in14p1 = vec2(0.05000, 0.05000);
	vec2 n_out14p0 = n_out13p0 + n_in14p1;


// VectorOp:16
	vec2 n_in16p0 = vec2(1.00000, 1.00000);
	vec2 n_out16p0 = n_in16p0 - n_out14p0;


// VectorFunc:17
	vec2 n_out17p0 = trunc(n_out16p0);


// Output:0
	ALBEDO = vec3(n_out9p0.xyz);
	ALPHA = n_out17p0.x;
	EMISSION = vec3(n_out9p0.xyz);


}
