code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;


// Varyings
varying float var_WorldPos;

uniform float ScanlineScrollSpeed;
uniform float ScanlineScale;
uniform sampler2D ScanlineTexture;
uniform vec4 ScanlineColor : source_color;
uniform float FresnelPower = 1;
uniform vec4 FresnelColor : source_color;



void vertex() {
// Input:3
	mat4 n_out3p0 = MODEL_MATRIX;


// Input:4
	vec3 n_out4p0 = VERTEX;


// TransformVectorMult:5
	vec3 n_out5p0 = (n_out3p0 * vec4(n_out4p0, 1.0)).xyz;


// VaryingSetter:2
	var_WorldPos = n_out5p0.x;


}

void fragment() {
// FloatParameter:6
	float n_out6p0 = ScanlineScrollSpeed;


// Input:7
	float n_out7p0 = TIME;


// FloatOp:8
	float n_out8p0 = n_out6p0 * n_out7p0;


// VaryingGetter:9
	float n_out9p0 = var_WorldPos;


// VectorDecompose:10
	float n_out10p0 = vec3(n_out9p0).x;
	float n_out10p1 = vec3(n_out9p0).y;
	float n_out10p2 = vec3(n_out9p0).z;


// FloatParameter:11
	float n_out11p0 = ScanlineScale;


// FloatOp:12
	float n_out12p0 = n_out10p1 * n_out11p0;


// FloatOp:13
	float n_out13p0 = n_out8p0 + n_out12p0;


// VectorCompose:14
	float n_in14p0 = 0.00000;
	vec2 n_out14p0 = vec2(n_in14p0, n_out13p0);


	vec4 n_out2p0;
// Texture2D:2
	n_out2p0 = texture(ScanlineTexture, n_out14p0);


// ColorParameter:4
	vec4 n_out4p0 = ScanlineColor;


// VectorOp:5
	vec4 n_out5p0 = n_out2p0 * n_out4p0;
	float n_out5p4 = n_out5p0.a;


// FloatParameter:16
	float n_out16p0 = FresnelPower;


// Fresnel:15
	float n_out15p0 = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), n_out16p0);


// ColorParameter:17
	vec4 n_out17p0 = FresnelColor;


// VectorOp:18
	vec4 n_out18p0 = vec4(n_out15p0) * n_out17p0;
	float n_out18p4 = n_out18p0.a;


// FloatOp:20
	float n_out20p0 = n_out5p4 + n_out18p4;


// VectorOp:19
	vec4 n_out19p0 = n_out5p0 + n_out18p0;


// Output:0
	ALPHA = n_out20p0;
	EMISSION = vec3(n_out19p0.xyz);


}
"
